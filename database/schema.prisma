generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role String @default("CUSTOMER")
  mfaEnabled Boolean @default(false)
  disabled Boolean @default(false)
  phone String?
  createdAt DateTime @default(now())
}
model Session {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  familyId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model Challenge {
  id String @id @default(uuid())
  userId String
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  used Boolean @default(false)
}
model Wallet {
  id String @id @default(uuid())
  userId String?
  name String
  currency String @default("INR")
  type String @default("CUSTOMER")
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  @@index([userId])
}
model Account {
  id String @id @default(uuid())
  userId String
  label String
  reference String @unique
  createdAt DateTime @default(now())
}
model Beneficiary {
  id String @id @default(uuid())
  userId String
  walletId String
  name String
  createdAt DateTime @default(now())
  @@unique([userId,walletId])
}
model Transaction {
  id String @id @default(uuid())
  userId String?
  fromWalletId String
  toWalletId String
  amount Decimal @db.Decimal(20,2)
  currency String @default("INR")
  kind String
  status String @default("PENDING")
  description String
  originalId String? @unique
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
  @@index([fromWalletId,createdAt])
  @@index([toWalletId,createdAt])
}
model LedgerEntry {
  id String @id @default(uuid())
  transactionId String
  walletId String
  direction String
  amount Decimal @db.Decimal(20,2)
  createdAt DateTime @default(now())
  @@index([walletId,createdAt])
  @@index([transactionId])
}
model Hold {
  id String @id @default(uuid())
  walletId String
  amount Decimal @db.Decimal(20,2)
  status String @default("ACTIVE")
  reason String
  createdAt DateTime @default(now())
}
model Idempotency {
  id String @id
  payloadHash String
  transactionId String @unique
  createdAt DateTime @default(now())
}
model PaymentIntent {
  id String @id @default(uuid())
  userId String
  walletId String
  amount Decimal @db.Decimal(20,2)
  currency String @default("INR")
  provider String
  providerId String @unique
  status String @default("PENDING")
  transactionId String? @unique
  createdAt DateTime @default(now())
}
model ProviderEvent {
  id String @id
  intentId String
  type String
  amount Decimal @db.Decimal(20,2)
  status String
  createdAt DateTime @default(now())
}
model Settlement {
  id String @id @default(uuid())
  intentId String @unique
  providerEventId String @unique
  amount Decimal @db.Decimal(20,2)
  status String
  createdAt DateTime @default(now())
}
model Refund {
  id String @id @default(uuid())
  transactionId String @unique
  compensationId String @unique
  kind String
  reason String
  providerId String?
  createdAt DateTime @default(now())
}
model ExternalRefund {
  id String @id @default(uuid())
  transactionId String @unique
  holdId String @unique
  actorId String
  reason String
  status String @default("PENDING")
  providerId String?
  compensationId String?
  attempts Int @default(0)
  createdAt DateTime @default(now())
}
model Dispute {
  id String @id @default(uuid())
  userId String
  transactionId String
  reason String
  status String @default("OPEN")
  assignedTo String?
  resolution String?
  history Json
  createdAt DateTime @default(now())
}
model RiskAlert {
  id String @id @default(uuid())
  userId String
  score Int
  level String
  reasons Json
  status String @default("OPEN")
  resolution String?
  createdAt DateTime @default(now())
}
model Reconciliation {
  id String @id @default(uuid())
  intentId String @unique
  status String
  details String
  resolvedBy String?
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Notification {
  id String @id @default(uuid())
  userId String
  title String
  message String
  read Boolean @default(false)
  deliveryStatus String @default("PENDING")
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}
model Audit {
  id String @id @default(uuid())
  actorId String?
  action String
  resourceId String?
  requestId String
  metadata Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model Setting {
  key String @id
  value String
  updatedAt DateTime @updatedAt
}
